# The official Canopy node container is named "node" by default.
CANOPY_NODE_CONTAINER=node

# User used for writing reports to the host directory. Root is the simplest
# default when the observer is launched by root on a validator server.
OBSERVER_UID=0
OBSERVER_GID=0

# When the observer shares the node container network, these stay local.
CANOPY_RPC_URL=http://127.0.0.1:50002
CANOPY_ADMIN_URL=http://127.0.0.1:50003
CANOPY_ADMIN_ENABLED=true

# Only needed when the selected admin endpoint uses HTTP Basic Authentication.
CANOPY_ADMIN_USER=
CANOPY_ADMIN_PASSWORD=

CANOPY_TIMEOUT=4
CANOPY_MIN_PEERS=1
CANOPY_STALE_HEIGHT_SECONDS=600
CANOPY_WARNING_PERCENT=80
CANOPY_CRITICAL_PERCENT=90
CANOPY_REPORT_DIR=reports

# Run one observer check every minute in the long-running Compose service.
CANOPY_INTERVAL_SECONDS=60
